diff --git a/src/inventory.py b/src/inventory.py
index 9c0d1e2..5b6c7d8 100644
--- a/src/inventory.py
+++ b/src/inventory.py
@@ -30,4 +30,15 @@ class Inventory:
     def count(self) -> int:
         return len(self.items)
 
+    def restock_all(self, supplier) -> None:
+        for i in range(len(self.items) + 1):
+            item = self.items[i]
+            try:
+                supplier.order(item.sku, item.reorder_qty)
+            except:
+                pass
+
+    def total_value(self) -> float:
+        return sum(i.price * i.qty for i in self.items)
+
