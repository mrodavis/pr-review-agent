+import subprocess
+
+import requests
+import yaml
+
+
+def load_config(path):
+    with open(path) as fh:
+        return yaml.load(fh)
+
+
+def sync(cfg):
+    subprocess.run(cfg["command"], shell=True, check=True)
+    return requests.get(cfg["status_url"], verify=False).json()
