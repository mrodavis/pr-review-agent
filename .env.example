# Copy to .env for local runs. Never commit real values.

# rules    = deterministic rules only, no model
# offline  = rules plus the scripted model stand-in (no AWS)
# bedrock  = rules plus Amazon Bedrock
LLM_MODE=rules

# Bedrock (only for LLM_MODE=bedrock). Credentials come from the standard AWS
# chain: a profile locally, OIDC role credentials in GitHub Actions.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=

# Posting a review (only with --post --repo owner/name --pr N --sha HEAD).
# In Actions this is the job's own GITHUB_TOKEN.
# GITHUB_TOKEN=
